{
  "name": "smart-assembly-control",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 443 --strictPort",
    "build": "tsc && vite build",
    "lint": "eslint src --max-warnings 0",
    "test": "node --experimental-strip-types --test tests/*.test.ts tests/*.test.mjs",
    "setup:https": "pwsh -NoLogo -NoProfile -File scripts/setup-https.ps1",
    "configure:local": "node scripts/configure-local.mjs",
    "start": "node scripts/serve.mjs",
    "restart": "node scripts/restart.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 443 --strictPort"
  },
  "dependencies": {
    "@evefrontier/dapp-kit": "^0.1.2",
    "@mysten/dapp-kit-core": "^1.0.4",
    "@mysten/dapp-kit-react": "^1.0.2",
    "@mysten/sui": "^2.4.0",
    "@mysten/wallet-standard": "0.20.1",
    "@radix-ui/colors": "^3.0.0",
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/themes": "^3.2.1",
    "@tanstack/react-query": "^5.80.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.4",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "@typescript-eslint/parser": "^8.33.1",
    "@vitejs/plugin-react-swc": "^3.10.1",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "packageManager": "pnpm@11.19.0"
}
